# =============================================================================
#  生产环境变量 — 复制此文件为 .env 并填入真实值
#  cp .env.example .env
# =============================================================================

# 数据库用户名（默认 postgres）
DB_USERNAME=postgres

# 数据库密码（必填）
DB_PASSWORD=your_db_password_here

# 阿里云百炼 DashScope API Key（必填）
DASHSCOPE_API_KEY=sk-your_api_key_here

# SearXNG 密钥（可选，留空会自动生成随机值）
SEARXNG_SECRET_KEY=
